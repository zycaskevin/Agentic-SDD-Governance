{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Action",
  "type": "object",
  "required": ["action_id", "summary", "risk_level", "owner", "action_class", "scope", "status", "created_at", "expires_at", "request_sha256", "authorization_scope"],
  "properties": {
    "action_id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "risk_level": {"enum": ["L1", "L2", "L3"]},
    "owner": {"type": "string", "minLength": 1},
    "action_class": {"enum": ["operational_action", "necessary_uat"]},
    "scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "completed", "cancelled", "expired"]},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authorization_scope": {"const": "one concrete action only"},
    "resolved_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
    "resolution_receipt_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
    "resolution_evidence_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
    "resolution_envelope": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/resolutionEnvelope"}]}
  },
  "$defs": {
    "resolutionEnvelope": {
      "type": "object",
      "required": ["schema_version", "algorithm", "receipt", "signature"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "algorithm": {"const": "ed25519"},
        "receipt": {
          "type": "object",
          "required": ["resolution_id", "action_id", "action_class", "owner", "scope", "request_sha256", "status", "evidence_sha256", "resolved_at", "expires_at", "nonce"],
          "properties": {
            "resolution_id": {"type": "string", "minLength": 1},
            "action_id": {"type": "string", "minLength": 1},
            "action_class": {"enum": ["operational_action", "necessary_uat"]},
            "owner": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1},
            "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "status": {"enum": ["completed", "cancelled"]},
            "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "resolved_at": {"type": "string", "format": "date-time"},
            "expires_at": {"type": "string", "format": "date-time"},
            "nonce": {"type": "string", "minLength": 12}
          },
          "additionalProperties": false
        },
        "signature": {"type": "string", "minLength": 88, "maxLength": 88}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["completed", "cancelled"]}}, "required": ["status"]},
      "then": {
        "required": ["resolved_at", "resolution_receipt_sha256", "resolution_evidence_sha256", "resolution_envelope"],
        "properties": {
          "resolved_at": {"type": "string", "format": "date-time"},
          "resolution_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "resolution_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "resolution_envelope": {"$ref": "#/$defs/resolutionEnvelope"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]},
      "then": {
        "properties": {
          "resolved_at": {"type": "null"},
          "resolution_receipt_sha256": {"type": "null"},
          "resolution_evidence_sha256": {"type": "null"},
          "resolution_envelope": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "expired"}}, "required": ["status"]},
      "then": {
        "required": ["resolved_at"],
        "properties": {
          "resolved_at": {"type": "string", "format": "date-time"},
          "resolution_receipt_sha256": {"type": "null"},
          "resolution_evidence_sha256": {"type": "null"},
          "resolution_envelope": {"type": "null"}
        }
      }
    }
  ],
  "additionalProperties": false
}
