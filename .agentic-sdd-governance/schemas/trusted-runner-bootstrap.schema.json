{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDG External Trusted Runner Bootstrap",
  "type": "object",
  "required": ["schema_version", "runner_id", "mode", "service_uid", "allowed_client_uids", "state_root", "trusted_approvers_file", "result_private_key", "result_public_key", "runtime_executable", "runtime_sha256", "runtime_argv", "credential_ref", "credential_path", "credential_sha256", "credential_binding_hash", "isolation_parent"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "runner_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["production", "rehearsal"]},
    "service_uid": {"type": "integer", "minimum": 0},
    "allowed_client_uids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "state_root": {"$ref": "#/$defs/absolutePath"},
    "trusted_approvers_file": {"$ref": "#/$defs/absolutePath"},
    "result_private_key": {"$ref": "#/$defs/absolutePath"},
    "result_public_key": {"type": "string", "minLength": 44, "maxLength": 44},
    "runtime_executable": {"$ref": "#/$defs/absolutePath"},
    "runtime_sha256": {"$ref": "#/$defs/digest"},
    "runtime_argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 16384}},
    "credential_ref": {"type": "string", "pattern": "^secret-ref://", "minLength": 14},
    "credential_path": {"$ref": "#/$defs/absolutePath"},
    "credential_sha256": {"$ref": "#/$defs/digest"},
    "credential_binding_hash": {"$ref": "#/$defs/digest"},
    "isolation_parent": {"$ref": "#/$defs/absolutePath"}
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/", "minLength": 2},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
