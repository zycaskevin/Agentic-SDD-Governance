{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDG Signed L2 Product Decision Approval Receipt",
  "description": "Sign UTF-8 bytes of json.dumps(receipt, ensure_ascii=False, sort_keys=True, separators=(',', ':')); encode the Ed25519 signature as padded Base64.",
  "type": "object",
  "required": ["schema_version", "algorithm", "receipt", "signature"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm": {"const": "ed25519"},
    "receipt": {
      "type": "object",
      "required": ["decision_id", "summary", "scope", "assumptions", "assumptions_sha256", "reopen_condition", "approved_by", "issued_at", "expires_at", "nonce"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "assumptions_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reopen_condition": {"const": "scope_or_assumptions_change"},
        "approved_by": {"type": "string", "minLength": 1},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "nonce": {"type": "string", "minLength": 12}
      },
      "additionalProperties": false
    },
    "signature": {"type": "string", "minLength": 88, "maxLength": 88}
  },
  "additionalProperties": false
}
