{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Action Resolution Receipt",
  "type": "object",
  "required": ["schema_version", "algorithm", "receipt", "signature"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm": {"const": "ed25519"},
    "receipt": {
      "type": "object",
      "required": ["resolution_id", "action_id", "action_class", "owner", "scope", "request_sha256", "status", "evidence_sha256", "resolved_at", "expires_at", "nonce"],
      "properties": {
        "resolution_id": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1},
        "action_class": {"enum": ["operational_action", "necessary_uat"]},
        "owner": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["completed", "cancelled"]},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "resolved_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "nonce": {"type": "string", "minLength": 12}
      },
      "additionalProperties": false
    },
    "signature": {"type": "string", "minLength": 88, "maxLength": 88}
  },
  "additionalProperties": false
}
