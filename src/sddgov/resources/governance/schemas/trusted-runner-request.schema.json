{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDG External Trusted Runner Exact Operation Request",
  "type": "object",
  "required": ["schema_version", "operation", "capsule", "sealed_bundle_delivery", "approval_required", "credential_delivery", "approval_id", "approval_envelope", "input_payload_b64"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "operation": {
      "type": "object",
      "required": ["contract_version", "action_id", "credential_ref", "input_payload_hash", "launch_contract_hash", "sealed_bundle_hash", "sealed_bundle_size_bytes", "sealed_bundle_entry_count", "source_tree_hash", "managed_hashes", "external_bindings", "route_profile_hash", "containment_profile_hash", "route_profile", "containment_profile", "provider", "model", "endpoint", "max_input_bytes", "max_output_tokens", "max_inference_calls", "max_cost_usd", "max_duration_seconds", "gate_mode", "rehearsal_only", "tool_policy", "approval_subagents", "auxiliary_inference", "promotion", "gate_enforce", "deployment", "external_trusted_runner_required", "operation_id"],
      "properties": {
        "contract_version": {"const": "0.3"},
        "action_id": {"const": "AF25-HERMES-OPENAI-API-LIVE-UAT-L3-001"},
        "credential_ref": {"type": "string", "pattern": "^secret-ref://", "minLength": 14},
        "input_payload_hash": {"$ref": "#/$defs/digest"},
        "launch_contract_hash": {"$ref": "#/$defs/digest"},
        "sealed_bundle_hash": {"$ref": "#/$defs/digest"},
        "sealed_bundle_size_bytes": {"type": "integer", "minimum": 1},
        "sealed_bundle_entry_count": {"type": "integer", "minimum": 1},
        "source_tree_hash": {"$ref": "#/$defs/digest"},
        "managed_hashes": {
          "type": "object",
          "required": ["agent/relay_llm.py", "agent/auxiliary_client.py", "hermes_cli/auth.py", "gateway/platforms/api_server.py", "agent/transports/codex.py"],
          "properties": {
            "agent/relay_llm.py": {"$ref": "#/$defs/digest"},
            "agent/auxiliary_client.py": {"$ref": "#/$defs/digest"},
            "hermes_cli/auth.py": {"$ref": "#/$defs/digest"},
            "gateway/platforms/api_server.py": {"$ref": "#/$defs/digest"},
            "agent/transports/codex.py": {"$ref": "#/$defs/digest"}
          },
          "additionalProperties": false
        },
        "external_bindings": {
          "type": "object",
          "required": ["contract_version", "runner_identity_hash", "approval_authority_identity_hash", "credential_binding_hash", "runtime_identity_hash", "isolation_policy_hash", "launch_contract_hash", "approval_protocol", "credential_protocol"],
          "properties": {
            "contract_version": {"const": "0.2"},
            "runner_identity_hash": {"$ref": "#/$defs/digest"},
            "approval_authority_identity_hash": {"$ref": "#/$defs/digest"},
            "credential_binding_hash": {"$ref": "#/$defs/digest"},
            "runtime_identity_hash": {"$ref": "#/$defs/digest"},
            "isolation_policy_hash": {"$ref": "#/$defs/digest"},
            "launch_contract_hash": {"$ref": "#/$defs/digest"},
            "approval_protocol": {"const": "sddgov-ed25519-exact-operation-v1"},
            "credential_protocol": {"const": "sealed-secret-fd-v1"}
          },
          "additionalProperties": false
        },
        "route_profile_hash": {"$ref": "#/$defs/digest"},
        "containment_profile_hash": {"$ref": "#/$defs/digest"},
        "route_profile": {"type": "object"},
        "containment_profile": {"type": "object"},
        "provider": {"const": "openai-api"},
        "model": {"const": "gpt-5.6-sol"},
        "endpoint": {"const": "https://api.openai.com/v1"},
        "max_input_bytes": {"const": 4096},
        "max_output_tokens": {"const": 1000},
        "max_inference_calls": {"const": 1},
        "max_cost_usd": {"const": "0.25"},
        "max_duration_seconds": {"const": 120},
        "gate_mode": {"const": "shadow"},
        "rehearsal_only": {"type": "boolean"},
        "tool_policy": {"const": "zero"},
        "approval_subagents": {"const": "denied"},
        "auxiliary_inference": {"const": "denied"},
        "promotion": {"const": false},
        "gate_enforce": {"const": false},
        "deployment": {"const": false},
        "external_trusted_runner_required": {"const": true},
        "operation_id": {"type": "string", "pattern": "^AF25-HERMES-OPENAI-API-LIVE-UAT-L3-001@[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "capsule": {
      "type": "object",
      "required": ["contract_version", "operation_id", "plan_hash", "sealed_bundle_hash", "external_bindings_hash", "environment_hash", "rehearsal_only", "credential_material_included", "authorization_consumed", "launch_permitted", "runtime_started", "inference_applied", "promotion_applied", "gate_enforce_applied", "deployment_applied"],
      "properties": {
        "contract_version": {"const": "0.3"},
        "operation_id": {"type": "string", "minLength": 1},
        "plan_hash": {"$ref": "#/$defs/digest"},
        "sealed_bundle_hash": {"$ref": "#/$defs/digest"},
        "external_bindings_hash": {"$ref": "#/$defs/digest"},
        "environment_hash": {"$ref": "#/$defs/digest"},
        "rehearsal_only": {"type": "boolean"},
        "credential_material_included": {"const": false},
        "authorization_consumed": {"const": false},
        "launch_permitted": {"const": false},
        "runtime_started": {"const": false},
        "inference_applied": {"const": false},
        "promotion_applied": {"const": false},
        "gate_enforce_applied": {"const": false},
        "deployment_applied": {"const": false}
      },
      "additionalProperties": false
    },
    "sealed_bundle_delivery": {"const": "inherited-sealed-fd"},
    "approval_required": {"const": true},
    "credential_delivery": {"const": "external-runner-private-fd"},
    "approval_id": {"type": "string", "minLength": 1},
    "approval_envelope": {"type": "object", "required": ["schema_version", "algorithm", "receipt", "signature"]},
    "input_payload_b64": {"type": "string", "minLength": 4, "maxLength": 5464}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "additionalProperties": false
}
