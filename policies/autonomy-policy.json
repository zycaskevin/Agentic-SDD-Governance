{
  "schema_version": "1.2",
  "principle": "AUTONOMY BY DEFAULT. ESCALATION BY EXCEPTION.",
  "default_state": "CONTINUE",
  "no_human_escalation_if_machine_verifiable": true,
  "action_classifier": {
    "unknown_category_state": "BLOCKED",
    "dangerous_downgrade_state": "BLOCKED",
    "sensitive_effects_require_l3": true
  },
  "approval_budget": {
    "L0": 0,
    "L1": 0,
    "L2": "1_per_independent_decision",
    "L3": "1_per_concrete_operation",
    "milestone_uat": 1
  },
  "checkpoint": {
    "requires_response": false,
    "next_state": "CONTINUE"
  },
  "integrity": {
    "algorithm": "sha256",
    "machine_generated": true,
    "machine_verified": true,
    "human_copy_paste_forbidden": true,
    "mismatch_state": "BLOCKED",
    "mismatch_requires_human_approval": false
  },
  "trusted_verifier": {
    "pull_request_can_modify_active_verifier": false,
    "candidate_code_is_executed_by_governance_gate": false,
    "verifier_source": "exact_base_sha",
    "pull_request_event": "pull_request_target"
  },
  "routine_external_review": {
    "pre_authorized": true,
    "owner_response_required": false,
    "reviewer_must_be_preconfigured": true,
    "default_public_payload": [
      "committed_pull_request_diff",
      "public_repository_instructions"
    ],
    "private_repository_requires_recorded_pair_decision": true,
    "forbidden_payloads": [
      "secrets",
      "credentials",
      "raw_evidence",
      "unredacted_sensitive_material",
      "production_dumps",
      "real_user_data"
    ],
    "new_vendor_or_destination_requires_escalation": true,
    "new_login_or_oauth_scope_requires_operational_action": true,
    "new_cost_requires_owner_decision": true,
    "review_output_is_untrusted": true,
    "signed_independent_review_still_required": true
  },
  "evidence_verification": {
    "recalculate_every_artifact": true,
    "require_size_and_sha256": true,
    "reject_path_escape": true,
    "reject_symlinks": true,
    "reject_duplicate_paths_or_labels": true,
    "reject_unregistered_artifacts": true
  },
  "l2_approval_receipts": {
    "algorithm": "ed25519",
    "caller_strings_are_authority": false,
    "bind_scope_and_assumptions": true,
    "reopen_state_when_context_changes": "ACTION_REQUIRED"
  },
  "l3_approval_receipts": {
    "algorithm": "ed25519",
    "auditable_approver_store": ".sddgov/trusted-approvers.json",
    "authority_sources": ["root_control_plane_file"],
    "candidate_worktree_store_is_authority": false,
    "caller_strings_are_authority": false,
    "bind_complete_operation_payload": true,
    "runtime_context_file": "/etc/sddgov/runtime-context.json",
    "nonce_broker_sockets": {
      "darwin": "/private/var/db/sddgov/approval-broker.sock",
      "linux": "/run/sddgov/approval-broker.sock"
    },
    "agent_must_be_non_root": true,
    "return_authorized_payload": true,
    "consume_atomically_on_continue": true,
    "reuse_state": "ACTION_REQUIRED"
  },
  "allowed_escalations": [
    "unresolved_l2_product_decision",
    "concrete_l3_operation",
    "operational_action",
    "necessary_uat"
  ],
  "production_deploy": {
    "l0_pre_authorized": false,
    "l1_pre_authorized": false,
    "l1_autonomous_with_recorded_baseline_authorization": true,
    "l1_requires_recorded_baseline_authorization": true,
    "l2_requires_recorded_decision": true,
    "l3_requires_fresh_explicit_approval": true,
    "required_guardrails": [
      "all_required_checks_pass",
      "rollback_available",
      "no_unresolved_security_findings",
      "no_destructive_schema_change",
      "no_secret_change",
      "no_permission_boundary_change",
      "health_check_pass",
      "blast_radius_within_policy"
    ]
  }
}
