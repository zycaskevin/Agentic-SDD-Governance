{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Action",
  "type": "object",
  "required": ["action_id", "summary", "risk_level", "owner", "action_class", "scope", "status", "created_at", "expires_at", "request_sha256", "authorization_scope"],
  "properties": {
    "action_id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "risk_level": {"enum": ["L1", "L2", "L3"]},
    "owner": {"type": "string", "minLength": 1},
    "action_class": {"const": "operational_action"},
    "scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "approved", "completed", "cancelled"]},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authorization_scope": {"const": "one concrete action only"}
  },
  "additionalProperties": false
}
