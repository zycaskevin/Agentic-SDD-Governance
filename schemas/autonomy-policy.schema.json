{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDG Autonomous Development Policy",
  "type": "object",
  "required": [
    "schema_version",
    "principle",
    "default_state",
    "no_human_escalation_if_machine_verifiable",
    "action_classifier",
    "effect_channels",
    "approval_budget",
    "checkpoint",
    "classifier_exit_codes",
    "action_required_binding",
    "external_action_lifecycle",
    "integrity",
    "trusted_verifier",
    "routine_external_review",
    "evidence_verification",
    "l2_product_decisions",
    "l3_approval_receipts",
    "allowed_escalations",
    "production_deploy"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "principle": {"const": "AUTONOMY BY DEFAULT. ESCALATION BY EXCEPTION."},
    "default_state": {"const": "CONTINUE"},
    "no_human_escalation_if_machine_verifiable": {"const": true},
    "action_classifier": {
      "type": "object",
      "required": ["unknown_category_state", "dangerous_downgrade_state", "sensitive_effects_require_l3", "malformed_request_state", "category_risk_must_match_exactly", "uncertainty_can_emit_action_required"],
      "properties": {
        "unknown_category_state": {"const": "BLOCKED"},
        "dangerous_downgrade_state": {"const": "BLOCKED"},
        "sensitive_effects_require_l3": {"const": true},
        "malformed_request_state": {"const": "BLOCKED"},
        "category_risk_must_match_exactly": {"const": true},
        "uncertainty_can_emit_action_required": {"const": false}
      },
      "additionalProperties": false
    },
    "effect_channels": {
      "type": "object",
      "required": ["merge_default_level", "merge_owner_operations", "release_readiness_level", "release_readiness_owner_operations", "reality_effect_requires_canonical_l3_operation", "public_publish_effect"],
      "properties": {
        "merge_default_level": {"const": "L1"},
        "merge_owner_operations": {"const": 0},
        "release_readiness_level": {"const": "L1"},
        "release_readiness_owner_operations": {"const": 0},
        "reality_effect_requires_canonical_l3_operation": {"const": true},
        "public_publish_effect": {"const": "public_publish"}
      },
      "additionalProperties": false
    },
    "approval_budget": {
      "type": "object",
      "required": ["L0", "L1", "L2", "L3", "milestone_uat"],
      "properties": {
        "L0": {"const": 0},
        "L1": {"const": 0},
        "L2": {"const": "1_per_independent_decision"},
        "L3": {"const": "1_per_concrete_operation"},
        "milestone_uat": {"const": 1}
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["requires_response", "next_state"],
      "properties": {
        "requires_response": {"const": false},
        "next_state": {"const": "CONTINUE"}
      },
      "additionalProperties": false
    },
    "classifier_exit_codes": {
      "type": "object",
      "required": ["CONTINUE", "BLOCKED", "ACTION_REQUIRED", "PROCESS_ERROR"],
      "properties": {
        "CONTINUE": {"const": 0},
        "BLOCKED": {"const": 1},
        "ACTION_REQUIRED": {"const": 2},
        "PROCESS_ERROR": {"const": 3}
      },
      "additionalProperties": false
    },
    "action_required_binding": {
      "type": "object",
      "required": ["risk_matches_category", "identity_matches_outer_request", "scope_matches_outer_request", "l3_exact_payload_required_before_prompt"],
      "properties": {
        "risk_matches_category": {"const": true},
        "identity_matches_outer_request": {"const": true},
        "scope_matches_outer_request": {"const": true},
        "l3_exact_payload_required_before_prompt": {"const": true}
      },
      "additionalProperties": false
    },
    "external_action_lifecycle": {
      "type": "object",
      "required": ["durable_classes", "pending_request_is_prompted_once", "resolution_requires_owner_signature", "signed_terminal_resolution_reverified_on_reuse", "only_expiry_is_an_unsigned_machine_transition", "necessary_uat_requires_subjective_judgment", "machine_verifiable_work_must_be_reclassified", "terminal_states", "unrelated_work_continues"],
      "properties": {
        "durable_classes": {"const": ["operational_action", "necessary_uat"]},
        "pending_request_is_prompted_once": {"const": true},
        "resolution_requires_owner_signature": {"const": true},
        "signed_terminal_resolution_reverified_on_reuse": {"const": true},
        "only_expiry_is_an_unsigned_machine_transition": {"const": true},
        "necessary_uat_requires_subjective_judgment": {"const": true},
        "machine_verifiable_work_must_be_reclassified": {"const": true},
        "terminal_states": {"const": ["completed", "cancelled", "expired"]},
        "unrelated_work_continues": {"const": true}
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "machine_generated", "machine_verified", "human_copy_paste_forbidden", "mismatch_state", "mismatch_requires_human_approval"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "machine_generated": {"const": true},
        "machine_verified": {"const": true},
        "human_copy_paste_forbidden": {"const": true},
        "mismatch_state": {"const": "BLOCKED"},
        "mismatch_requires_human_approval": {"const": false}
      },
      "additionalProperties": false
    },
    "trusted_verifier": {
      "type": "object",
      "required": ["pull_request_can_modify_active_verifier", "candidate_code_is_executed_by_governance_gate", "verifier_source", "pull_request_event"],
      "properties": {
        "pull_request_can_modify_active_verifier": {"const": false},
        "candidate_code_is_executed_by_governance_gate": {"const": false},
        "verifier_source": {"const": "exact_base_sha"},
        "pull_request_event": {"const": "pull_request_target"}
      },
      "additionalProperties": false
    },
    "routine_external_review": {
      "type": "object",
      "required": [
        "pre_authorized",
        "owner_response_required",
        "reviewer_must_be_preconfigured",
        "default_public_payload",
        "public_repository_required_for_pre_authorization",
        "private_repository_requires_separate_recorded_pair_authorization",
        "forbidden_payloads",
        "new_vendor_or_destination_requires_escalation",
        "new_access_requires_operational_action",
        "new_cost_requires_owner_decision",
        "review_output_is_untrusted",
        "signed_independent_review_still_required"
      ],
      "properties": {
        "pre_authorized": {"const": true},
        "owner_response_required": {"const": false},
        "reviewer_must_be_preconfigured": {"const": true},
        "default_public_payload": {
          "type": "array",
          "const": [
            "committed_pull_request_diff",
            "public_repository_instructions"
          ]
        },
        "public_repository_required_for_pre_authorization": {"const": true},
        "private_repository_requires_separate_recorded_pair_authorization": {"const": true},
        "forbidden_payloads": {
          "type": "array",
          "const": [
            "secrets",
            "credentials",
            "raw_evidence",
            "unredacted_sensitive_material",
            "production_dumps",
            "real_user_data"
          ]
        },
        "new_vendor_or_destination_requires_escalation": {"const": true},
        "new_access_requires_operational_action": {"const": true},
        "new_cost_requires_owner_decision": {"const": true},
        "review_output_is_untrusted": {"const": true},
        "signed_independent_review_still_required": {"const": true}
      },
      "additionalProperties": false
    },
    "evidence_verification": {
      "type": "object",
      "required": ["recalculate_every_artifact", "require_size_and_sha256", "reject_path_escape", "reject_symlinks", "reject_duplicate_paths_or_labels", "reject_unregistered_artifacts"],
      "properties": {
        "recalculate_every_artifact": {"const": true},
        "require_size_and_sha256": {"const": true},
        "reject_path_escape": {"const": true},
        "reject_symlinks": {"const": true},
        "reject_duplicate_paths_or_labels": {"const": true},
        "reject_unregistered_artifacts": {"const": true}
      },
      "additionalProperties": false
    },
    "l2_product_decisions": {
      "type": "object",
      "required": ["team_standard_mode", "team_standard_cryptographic_receipt_required", "team_standard_owner_operations_max", "solo_fast_cryptographic_receipt_required", "regulated_cryptographic_receipt_required", "bind_scope_and_assumptions", "reopen_state_when_context_changes"],
      "properties": {
        "team_standard_mode": {"const": "bounded_plain_language_choice"},
        "team_standard_cryptographic_receipt_required": {"const": false},
        "team_standard_owner_operations_max": {"const": 1},
        "solo_fast_cryptographic_receipt_required": {"const": true},
        "regulated_cryptographic_receipt_required": {"const": true},
        "bind_scope_and_assumptions": {"const": true},
        "reopen_state_when_context_changes": {"const": "ACTION_REQUIRED"}
      },
      "additionalProperties": false
    },
    "l3_approval_receipts": {
      "type": "object",
      "required": ["algorithm", "auditable_approver_store", "authority_sources", "candidate_worktree_store_is_authority", "caller_strings_are_authority", "bind_complete_operation_payload", "runtime_context_file", "nonce_broker_sockets", "agent_must_be_non_root", "return_authorized_payload", "consume_atomically_on_continue", "reuse_state"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "auditable_approver_store": {"const": ".sddgov/trusted-approvers.json"},
        "authority_sources": {
          "type": "array",
          "const": ["root_control_plane_file"]
        },
        "candidate_worktree_store_is_authority": {"const": false},
        "caller_strings_are_authority": {"const": false},
        "bind_complete_operation_payload": {"const": true},
        "runtime_context_file": {"const": "/etc/sddgov/runtime-context.json"},
        "nonce_broker_sockets": {
          "type": "object",
          "required": ["darwin", "linux"],
          "properties": {
            "darwin": {"const": "/private/var/db/sddgov/approval-broker.sock"},
            "linux": {"const": "/run/sddgov/approval-broker.sock"}
          },
          "additionalProperties": false
        },
        "agent_must_be_non_root": {"const": true},
        "return_authorized_payload": {"const": true},
        "consume_atomically_on_continue": {"const": true},
        "reuse_state": {"const": "ACTION_REQUIRED"}
      },
      "additionalProperties": false
    },
    "allowed_escalations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["unresolved_l2_product_decision", "concrete_l3_operation", "operational_action", "necessary_uat"]}
    },
    "production_deploy": {
      "type": "object",
      "required": ["l0_pre_authorized", "l1_pre_authorized", "l1_baseline_decision_can_authorize_execution", "l2_product_decision_can_authorize_execution", "actual_execution_requires_l3", "l3_requires_fresh_explicit_approval", "required_guardrails"],
      "properties": {
        "l0_pre_authorized": {"const": false},
        "l1_pre_authorized": {"const": false},
        "l1_baseline_decision_can_authorize_execution": {"const": false},
        "l2_product_decision_can_authorize_execution": {"const": false},
        "actual_execution_requires_l3": {"const": true},
        "l3_requires_fresh_explicit_approval": {"const": true},
        "required_guardrails": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "all_required_checks_pass",
              "rollback_available",
              "no_unresolved_security_findings",
              "no_destructive_schema_change",
              "no_secret_change",
              "no_permission_boundary_change",
              "health_check_pass",
              "blast_radius_within_policy"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
