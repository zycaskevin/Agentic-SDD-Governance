{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDG Trusted Approver Repository Domains",
  "type": "object",
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bindings": {
      "type": "array",
      "uniqueItems": true,
      "x-sddgov-unique-key": "approver_id",
      "items": {
        "type": "object",
        "required": ["approver_id", "repository_id", "repository_root", "trust_domain", "status"],
        "properties": {
          "approver_id": {"type": "string", "minLength": 1},
          "repository_id": {"type": "string", "pattern": "^github\\.com/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"},
          "repository_root": {"type": "string", "pattern": "^/"},
          "trust_domain": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "revoked"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
